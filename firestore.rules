rules_version = '2';

// First Frets stores one document per player: users/{uid}, holding only their chord stars,
// best change scores and practice days. Players can read, write and delete their own
// document and nobody else's. Writes are checked for shape and size.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validProgress() {
        let d = request.resource.data;
        return d.keys().hasOnly(['stars', 'best', 'days', 'updatedAt'])
          && d.keys().hasAll(['stars', 'best', 'days', 'updatedAt'])
          && d.stars is map && d.stars.size() <= 64
          && d.best is map && d.best.size() <= 400
          && d.days is list && d.days.size() <= 90
          && d.updatedAt == request.time;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validProgress();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
